server.port=4000

# Database Configuration
spring.datasource.url=jdbc:mysql://localhost:3306/Outreach Healthcare Care System?serverTimezone=Asia/Bangkok&useUnicode=true&characterEncoding=UTF-8
spring.datasource.username=root
spring.datasource.password=YOUR_DATABASE_PASSWORD
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# JPA & Hibernate
spring.jpa.hibernate.ddl-auto=update
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect
spring.jpa.show-sql=true
spring.jpa.open-in-view=false

# Date format globally
spring.jackson.date-format=yyyy-MM-dd
spring.jackson.time-zone=Asia/Bangkok

# JWT Setup (At least 256 bits for HS256)
jwt.secret=YOUR_JWT_SECRET_KEY_AT_LEAST_256_BITS
jwt.expiration=604800000

# File Upload Configuration
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB

# Slip Verification API Configuration
slip.verify.url=https://slip.xepht.com/api/v1/slips/verify
slip.receiver.account=YOUR_RECEIVER_ACCOUNT
slip.receiver.name=YOUR_RECEIVER_NAME
